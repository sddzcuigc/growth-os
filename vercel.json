{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/family-skill-tree.js": {
      "maxDuration": 30
    },
    "api/family-skill-tree-auth.js": {
      "maxDuration": 30
    },
    "api/skill-tree-bundle.js": {
      "maxDuration": 15
    },
    "api/skill-tree-auth-app.js": {
      "maxDuration": 30
    },
    "api/skill-tree-auth-client.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/family-skill-tree",
      "destination": "/api/family-skill-tree.js"
    },
    {
      "source": "/api/family-skill-tree-auth",
      "destination": "/api/family-skill-tree-auth.js"
    },
    {
      "source": "/skill-tree/auth-app.js",
      "destination": "/api/skill-tree-auth-app.js"
    },
    {
      "source": "/skill-tree/firebase-auth-client.js",
      "destination": "/api/skill-tree-auth-client.js"
    },
    {
      "source": "/skill-tree/p1.js",
      "destination": "/api/skill-tree-bundle.js?part=1"
    },
    {
      "source": "/skill-tree/p2.js",
      "destination": "/api/skill-tree-bundle.js?part=2"
    },
    {
      "source": "/skill-tree/p3.js",
      "destination": "/api/skill-tree-bundle.js?part=3"
    },
    {
      "source": "/skill-tree/p4.js",
      "destination": "/api/skill-tree-bundle.js?part=4"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.js"
    }
  ]
}
